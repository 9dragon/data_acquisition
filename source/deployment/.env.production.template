# 数据采集系统 - 生产环境配置模板
# 复制此文件为 .env.production 并修改相应的值
# 使用方法: cp .env.production.template .env.production

# ========== MySQL 配置 ==========
MYSQL_ROOT_PASSWORD=CHANGEME_ROOT_PASSWORD_32_CHARS
MYSQL_DATABASE=data_acquisition
MYSQL_USER=data_acquisition
MYSQL_PASSWORD=CHANGEME_DB_PASSWORD_32_CHARS

# ========== Redis 配置 ==========
REDIS_PASSWORD=CHANGEME_REDIS_PASSWORD_32_CHARS

# ========== MinIO 配置 ==========
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGEME_MINIO_PASSWORD_32_CHARS
MINIO_BUCKET_NAME=data-acquisition

# ========== 后端配置 ==========
DB_HOST=mysql
DB_USERNAME=data_acquisition
DB_PASSWORD=${MYSQL_PASSWORD}

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}

MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}

# ========== JVM 配置 ==========
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC

# ========== 钉钉配置（可选）==========
# 如需启用钉钉集成，请填写以下信息
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
DINGTALK_CORP_ID=
DINGTALK_SYNC_ENABLED=false

# ========== 镜像版本 ==========
# 通常由脚本自动管理，无需手动修改
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest
