<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dataacquisition.modules.system.mapper.RolePermissionMapper">

    <delete id="deleteByRoleId">
        DELETE FROM t_role_permission WHERE role_id = #{roleId}
    </delete>

    <insert id="insertBatch">
        INSERT INTO t_role_permission (role_id, permission_id, created_by, created_at) VALUES
        <foreach collection="permissionIds" item="permissionId" separator=",">
            (#{roleId}, #{permissionId}, #{createdBy}, NOW())
        </foreach>
    </insert>

</mapper>
